**/*.rs.bk
**/*.tmp*

.DS_Store
.idea
.secrets
.cargo/config.toml

.vscode
.claude
.scout

/semver-checks/target/
sdk/target/

.cursor/rules/manifest.json
.cursor/rules/security-global/*
.cursor/rules/security-lang/*
